load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "cgo_select_embed_keep",
    srcs = [
        "cgo_darwin.go",
        "pure.go",
    ],
    _gazelle_imports = [],
    cgo = True,
    importpath = "example.com/repo/cgo_select_embed_keep",
    visibility = ["//visibility:public"],
)

go_test(
    name = "cgo_select_embed_keep_test",
    srcs = ["lib_test.go"],
    _gazelle_imports = ["testing"],
    embed = [":cgo_select_embed_keep"],
)

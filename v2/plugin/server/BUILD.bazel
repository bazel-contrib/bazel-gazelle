load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "github.com/bazel-contrib/bazel-gazelle/v2/plugin/server",
    visibility = ["//visibility:public"],
    deps = ["//v2/plugin/protocol"],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "server.go",
        "server_test.go",
    ],
    visibility = ["//visibility:public"],
)

go_test(
    name = "server_test",
    srcs = ["server_test.go"],
    embed = [":server"],
    deps = ["//v2/plugin/protocol"],
)

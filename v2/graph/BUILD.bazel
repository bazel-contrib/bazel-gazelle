load("@io_bazel_rules_go//go:def.bzl", "go_library")

go_library(
    name = "graph",
    srcs = [
        "extension.go",
        "graph.go",
    ],
    importpath = "github.com/bazel-contrib/bazel-gazelle/v2/graph",
    visibility = ["//visibility:public"],
    deps = [
        "//v2/config",
        "//v2/internal/graph/model",
        "//v2/label",
        "//v2/resolve",
        "//v2/rule",
        "//v2/walk",
    ],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "extension.go",
        "graph.go",
    ],
    visibility = ["//visibility:public"],
)

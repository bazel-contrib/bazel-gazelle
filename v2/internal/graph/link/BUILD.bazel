load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "link",
    srcs = ["link.go"],
    importpath = "github.com/bazel-contrib/bazel-gazelle/v2/internal/graph/link",
    visibility = ["//v2:__subpackages__"],
    deps = [
        "//v2/config",
        "//v2/graph",
        "//v2/internal/graph/ingest",
        "//v2/internal/graph/model",
        "//v2/label",
        "//v2/resolve",
        "//v2/walk",
    ],
)

go_test(
    name = "link_test",
    srcs = ["link_test.go"],
    embed = [":link"],
    deps = [
        "//v2/config",
        "//v2/graph",
        "//v2/internal/graph/ingest",
        "//v2/internal/graph/model",
        "//v2/label",
        "//v2/resolve",
        "//v2/rule",
        "@com_github_google_go_cmp//cmp",
    ],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "link.go",
        "link_test.go",
    ],
    visibility = ["//visibility:public"],
)

load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ingest",
    srcs = ["ingest.go"],
    importpath = "github.com/bazel-contrib/bazel-gazelle/v2/internal/graph/ingest",
    visibility = ["//v2:__subpackages__"],
    deps = [
        "//v2/internal/graph/model",
        "//v2/label",
        "//v2/rule",
        "@com_github_bazelbuild_buildtools//build",
    ],
)

go_test(
    name = "ingest_test",
    srcs = ["ingest_test.go"],
    embed = [":ingest"],
    deps = [
        "//v2/internal/graph/model",
        "//v2/label",
        "//v2/rule",
        "@com_github_google_go_cmp//cmp",
    ],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "ingest.go",
        "ingest_test.go",
    ],
    visibility = ["//visibility:public"],
)

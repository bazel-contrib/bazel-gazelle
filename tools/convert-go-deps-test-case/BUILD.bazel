load("@bazel_gazelle_is_bazel_module//:defs.bzl", "GAZELLE_IS_BAZEL_MODULE")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

go_library(
    name = "convert-go-deps-test-case_lib",
    srcs = [
        "bzl_to_dir.go",
        "dir_to_bzl.go",
        "go_tool.go",
        "main.go",
        "schema.go",
    ],
    data = select({
        "@platforms//os:windows": ["@go_sdk//:bin/go.exe"],
        "//conditions:default": ["@go_sdk//:bin/go"],
    }),
    importpath = "github.com/bazelbuild/bazel-gazelle/tools/convert-go-deps-test-case",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_bazelbuild_buildtools//build",
        "@io_bazel_rules_go//go/runfiles",
        "@org_golang_x_mod//modfile",
    ],
)

go_binary(
    name = "convert-go-deps-test-case",
    embed = [":convert-go-deps-test-case_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "convert-go-deps-test-case_test",
    srcs = ["convert_test.go"],
    data = ["//tests/bzlmod/go_deps:test_cases"],
    embed = [":convert-go-deps-test-case_lib"],
    # Doesn't work in WORKSPACE mode, seems to pick a different Go version.
    tags = [] if GAZELLE_IS_BAZEL_MODULE else ["manual"],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

sh_binary(
    name = "repack",
    srcs = ["repack.sh"],
    data = [":convert-go-deps-test-case"],
    tags = ["manual"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "bzl_to_dir.go",
        "convert_test.go",
        "dir_to_bzl.go",
        "go_tool.go",
        "main.go",
        "repack.sh",
        "schema.go",
    ],
    visibility = ["//visibility:public"],
)
